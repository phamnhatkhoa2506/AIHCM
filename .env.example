# AIC 2026 — biến môi trường dùng chung cho hệ thống app/ (FastAPI + HTML/CSS/JS, xem app/backend/core/config.py)
# Copy file này thành ".env" (cùng thư mục, gốc monorepo) rồi điền giá trị thật của máy bạn — KHÔNG commit .env thật.
# v3/ (Streamlit) dùng .env riêng (v3/.env, các biến NVIDIA_NIM_API_KEY/GOOGLE_API_KEY) — 2 hệ thống độc lập từ 2026-08-21.

# ---- Đường dẫn dữ liệu (khác máy/khác ổ đĩa giữa các thành viên) ----

# Thư mục chứa video gốc BTC cấp (Videos_*.zip) — video_audio.py đọc trực tiếp để phát Playback
# + trích audio cho ASR. Mặc định: D:\Programming\AIHCM\data\Competition
AIC_DATA_ROOT=D:\Programming\AIHCM\data\Competition

# Thư mục index đã build (gộp phẳng — cả bản gốc BTC local_idx-based lẫn bản dense tự trích
# frame_idx-based cùng nằm ở đây, phân biệt bằng tiền tố "dense_", xem tiers/dense_search.py).
# Mặc định: D:\Programming\AIHCM\data\Runtime
AIC_INDEX_DIR=D:\Programming\AIHCM\data\Runtime

# Cache model HuggingFace/sentence-transformers (SigLIP2/PE-Core/BEiT-3 tokenizer/config tải về).
# Mặc định: <gốc app/>/.cache/huggingface
AIC_MODEL_CACHE_DIR=D:\Programming\AIHCM\app\.cache\huggingface

# ---- Chạy model local thay vì qua Modal (để trống = luôn gọi Modal remote) ----
# AIC_LOCAL_MODELS=1
# AIC_LOCAL_QUERY_ENCODER_SIGLIP=
# AIC_LOCAL_QUERY_ENCODER_PE_CORE=
# AIC_LOCAL_QUERY_ENCODER_BEIT3=
# AIC_LOCAL_DENSE_INDEX=
# AIC_LOCAL_REGION_CLIP=

# ---- API key (LLM phân rã câu/chưng cất query — query_planner.py/query_distill.py) ----
NVIDIA_NIM_API_KEY=
GOOGLE_API_KEY=
